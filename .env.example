# Шаблон настроек «Опоры». Скопируйте в .env и заполните только нужные значения.
# Секреты не коммитьте: .env исключён из git.

# Разрешённый origin веб-приложения для CORS API (через запятую).
APP_ORIGIN=http://localhost:3000

# Поиск компании по ИНН через DaData. Без ключа используется локальный индекс ФНС.
DADATA_API_KEY=
# Каталог импортированного индекса ФНС. По умолчанию — fns-data в корне репозитория;
# Compose монтирует его в контейнер read-only. Указывайте абсолютный путь.
# FNS_DATA_DIR=/absolute/path/to/fns-data

# GigaChat: ключ авторизации только для API, во frontend не передаётся.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro

# Фоновые циклы: мониторинг источников и обновление каталога/уведомлений. off — отключить.
AI_SOURCE_SYNC=on
FUNDING_SYNC=on

# Необязательный токен для внутреннего статуса мониторинга /api/internal/funding/status.
OPORA_MONITOR_TOKEN=
